+package com.google.devtools.build.lib.skycache;
+
+import com.google.auth.Credentials;
+import com.google.common.collect.ImmutableList;
+import com.google.devtools.build.lib.analysis.BlazeDirectories;
+import com.google.devtools.build.lib.authandtls.AuthAndTLSOptions;
+import com.google.devtools.build.lib.authandtls.GoogleAuthUtils;
+import com.google.devtools.build.lib.authandtls.credentialhelper.CredentialHelperEnvironment;
+import com.google.devtools.build.lib.authandtls.credentialhelper.CredentialModule;
+import com.google.devtools.build.lib.events.Event;
+import com.google.devtools.build.lib.events.ExtendedEventHandler;
+import com.google.devtools.build.lib.runtime.BlazeRuntime;
+import com.google.devtools.build.lib.runtime.CommandEnvironment;
+import com.google.devtools.build.lib.runtime.WorkspaceBuilder;
+import com.google.devtools.build.lib.server.FailureDetails.FailureDetail;
+import com.google.devtools.build.lib.server.FailureDetails.RemoteAnalysisCaching;
+import com.google.devtools.build.lib.skyframe.serialization.SerializationModule;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.FileDependencySerializer;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingOptions;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingServicesOptions;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingServicesSupplier;
+import com.google.devtools.build.lib.util.AbruptExitException;
+import com.google.devtools.build.lib.util.DetailedExitCode;
+import com.google.devtools.common.options.OptionsBase;
+import java.io.IOException;
+import javax.annotation.Nullable;
+
+/**
+ * Points Bazel's remote analysis caching at the analysis cache service.
+ *
+ * <p>Everything is driven by Bazel's existing flags: with {@code
+ * --experimental_remote_analysis_cache} unset, the supplier never connects and the module behaves
+ * exactly like the {@link SerializationModule} it replaces.
+ */
+public final class SkycacheModule extends SerializationModule {
+
+  private final SkycacheServicesSupplier supplier = new SkycacheServicesSupplier();
+
+  /** Shared with the remote module so one helper invocation serves both. */
+  @Nullable private CredentialModule credentialModule;
+
+  /** Held from {@code beforeCommand} because {@link #afterCommand} is handed no environment. */
+  @Nullable private ExtendedEventHandler eventHandler;
+
+  @Override
+  protected RemoteAnalysisCachingServicesSupplier getAnalysisCachingServicesSupplier(
+      BlazeRuntime runtime) {
+    return supplier;
+  }
+
+  @Override
+  public void workspaceInit(
+      BlazeRuntime runtime, BlazeDirectories directories, WorkspaceBuilder builder) {
+    super.workspaceInit(runtime, directories, builder);
+    credentialModule = runtime.getBlazeModule(CredentialModule.class);
+  }
+
+  /**
+   * Declares the auth options and the cache's batching options, which no build command otherwise
+   * declares.
+   *
+   * <p>The parser rejects reading an options class a command did not declare. {@code
+   * --credential_helper} lives in {@link AuthAndTLSOptions}, which reaches only commands the remote
+   * module claims, and the batch, deadline and in-flight flags live in {@link
+   * RemoteAnalysisCachingServicesOptions}, which upstream registers nowhere.
+   */
+  @Override
+  public Iterable<Class<? extends OptionsBase>> getCommandOptions(String commandName) {
+    return "build".equals(commandName)
+        ? ImmutableList.of(AuthAndTLSOptions.class, RemoteAnalysisCachingServicesOptions.class)
+        : ImmutableList.of();
+  }
+
+  /**
+   * Supplies the version oracle the frontier serializer requires, and the caller's credentials.
+   *
+   * <p>Without the oracle, upload dies on {@code NullPointerException("missing versionGetter")}:
+   * {@code FrontierSerializer} falls back only to a test injection, and Bazel ships no
+   * implementation for ordinary use.
+   */
+  @Override
+  public void beforeCommand(CommandEnvironment env) throws AbruptExitException {
+    eventHandler = env.getReporter();
+    env.setVersionGetter(UnchangedLongVersionGetter.INSTANCE);
+
+    // An open-source output base is built from absolute symlinks, which the frontier serializer
+    // rejects outright. Tolerating them is only correct alongside this cache, so it follows the
+    // same flag the supplier does and a stock build keeps the assertion.
+    RemoteAnalysisCachingOptions options =
+        env.getOptions().getOptions(RemoteAnalysisCachingOptions.class);
+    boolean enabled =
+        options != null
+            && options.getRemoteAnalysisCache() != null
+            && !options.getRemoteAnalysisCache().isEmpty();
+    FileDependencySerializer.setTolerateAbsoluteSymlinks(enabled);
+    if (!enabled) {
+      return;
+    }
+
+    AuthAndTLSOptions authAndTlsOptions = env.getOptions().getOptions(AuthAndTLSOptions.class);
+    if (authAndTlsOptions == null || credentialModule == null) {
+      // Both are present for every command that can reach this; a null means the module graph
+      // changed under it, and guessing a credential-free channel would fail far from the cause.
+      throw abruptExit("remote analysis caching could not reach Bazel's credential machinery");
+    }
+
+    // The same path --remote_cache takes: a credential helper per --credential_helper, falling
+    // back to .netrc and to Google application-default credentials. The cache is shared with the
+    // remote module, so a helper is invoked once per URI per build rather than once per consumer.
+    Credentials credentials;
+    try {
+      credentials =
+          GoogleAuthUtils.newCredentials(
+              CredentialHelperEnvironment.newBuilder()
+                  .setEventReporter(env.getReporter())
+                  .setWorkspacePath(env.getWorkspace())
+                  .setClientEnvironment(env::getClientEnv)
+                  .setHelperExecutionTimeout(authAndTlsOptions.getCredentialHelperTimeout())
+                  .build(),
+              credentialModule.getCredentialCache(),
+              env.getCommandLinePathFactory(),
+              env.getRuntime().getFileSystem(),
+              authAndTlsOptions);
+    } catch (IOException e) {
+      throw abruptExit("resolving credentials for the remote analysis cache: " + e.getMessage());
+    }
+    supplier.setCredentials(authAndTlsOptions, credentials);
+  }
+
+  @Override
+  public void afterCommand() {
+    long shed = supplier.shedReads();
+    if (shed > 0 && eventHandler != null) {
+      // Shed reads are answered as misses, so the build is correct but quietly less cached than it
+      // reports. Nothing else in the stats distinguishes this from a genuinely cold cache.
+      eventHandler.handle(
+          Event.warn(
+              String.format(
+                  "Analysis cache: %d reads were evaluated locally because"
+                      + " --experimental_remote_analysis_cache_max_in_flight_read_requests was"
+                      + " reached.",
+                  shed)));
+    }
+    eventHandler = null;
+    super.afterCommand();
+  }
+
+  private static AbruptExitException abruptExit(String message) {
+    return new AbruptExitException(
+        DetailedExitCode.of(
+            FailureDetail.newBuilder()
+                .setMessage(message)
+                .setRemoteAnalysisCaching(
+                    RemoteAnalysisCaching.newBuilder()
+                        .setCode(RemoteAnalysisCaching.Code.REMOTE_ANALYSIS_CACHING_UNKNOWN))
+                .build()));
+  }
+}
diff --git a/src/main/java/com/google/devtools/build/lib/skycache/SkycacheServicesSupplier.java b/src/main/java/com/google/devtools/build/lib/skycache/SkycacheServicesSupplier.java
new file mode 100644
index 00000000000..ed04dca860c
--- /dev/null
+++ b/src/main/java/com/google/devtools/build/lib/skycache/SkycacheServicesSupplier.java
@@ -0,0 +1,236 @@
+// Copyright 2026 The Bazel Authors. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//    http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+package com.google.devtools.build.lib.skycache;
+
+import static com.google.common.util.concurrent.Futures.immediateFuture;
+import static java.util.concurrent.ForkJoinPool.commonPool;
+
+import build.aspect.skycache.v1.AnalysisCacheGrpc;
+import build.aspect.skycache.v1.AnalysisCacheGrpc.AnalysisCacheFutureStub;
+import com.google.auth.Credentials;
+import com.google.common.util.concurrent.ListenableFuture;
+import com.google.devtools.build.lib.authandtls.AuthAndTLSOptions;
+import com.google.devtools.build.lib.authandtls.GoogleAuthUtils;
+import com.google.devtools.build.lib.concurrent.safeexecutor.SafeExecutor;
+import com.google.devtools.build.lib.concurrent.safeexecutor.SafeExecutorOwner;
+import com.google.devtools.build.lib.server.FailureDetails.FailureDetail;
+import com.google.devtools.build.lib.server.FailureDetails.RemoteAnalysisCaching;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.ClientId;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCacheMode;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingOptions;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingServicesOptions;
+import com.google.devtools.build.lib.skyframe.serialization.analysis.RemoteAnalysisCachingServicesSupplier;
+import com.google.devtools.build.lib.util.SerializedAbruptExitException;
+import com.google.devtools.common.options.OptionsProvider;
+import io.grpc.CallCredentials;
+import io.grpc.ManagedChannel;
+import java.io.IOException;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import javax.annotation.Nullable;
+
+/**
+ * Supplies both halves of the analysis cache from one gRPC connection.
+ *
+ * <p>Configured from {@link RemoteAnalysisCachingOptions}, {@link
+ * RemoteAnalysisCachingServicesOptions} and the credentials {@link SkycacheModule} resolves;
+ * nothing here reads the environment. With {@code --experimental_remote_analysis_cache} unset the
+ * supplier stays inert and the module falls back to stock behaviour.
+ */
+final class SkycacheServicesSupplier implements RemoteAnalysisCachingServicesSupplier {
+
+  /**
+   * How long a partial write batch waits for company before being sent.
+   *
+   * <p>Not a flag, and not worth one: a write has nothing blocked behind it, so this only has to be
+   * short enough to drain the tail of a build.
+   */
+  private static final long PUT_LINGER_MILLIS = 50;
+
+  /**
+   * Outbound message size ceiling, in bytes.
+   *
+   * <p>gRPC's 4 MiB default is below what a full write batch carries. The inbound direction needs
+   * no setting here: {@link GoogleAuthUtils#newChannel} already lifts it for the same reason.
+   */
+  private static final int MAX_OUTBOUND_MESSAGE_BYTES = 256 * 1024 * 1024;
+
+  /** Never shut down, so it outlives every command that borrows it; the common pool is shared. */
+  private static final SafeExecutorOwner COMMAND_EXECUTOR = new SafeExecutorOwner(commonPool());
+
+  @Nullable private ManagedChannel channel;
+  @Nullable private GrpcAnalysisCacheClient client;
+  @Nullable private GrpcFingerprintValueStore store;
+  @Nullable private BatchingGetQueue gets;
+  @Nullable private ScheduledExecutorService scheduler;
+  private long shedAtReset;
+
+  /** Set by the module before any command that could configure this. */
+  @Nullable private AuthAndTLSOptions authAndTlsOptions;
+
+  @Nullable private Credentials credentials;
+
+  /**
+   * Hands over what the module resolved from Bazel's own credential machinery.
+   *
+   * <p>Separate from {@link #configure} because that signature belongs to the interface, and
+   * because credential resolution needs the command environment, which it is not handed.
+   */
+  void setCredentials(AuthAndTLSOptions authAndTlsOptions, @Nullable Credentials credentials) {
+    this.authAndTlsOptions = authAndTlsOptions;
+    this.credentials = credentials;
+  }
+
+  @Override
+  public void configure(
+      OptionsProvider optionsProvider,
+      RemoteAnalysisCacheMode mode,
+      @Nullable ClientId clientId,
+      String buildId)
+      throws SerializedAbruptExitException {
+    RemoteAnalysisCachingOptions cachingOptions =
+        optionsProvider.getOptions(RemoteAnalysisCachingOptions.class);
+    String target = cachingOptions == null ? null : cachingOptions.getRemoteAnalysisCache();
+    if (target == null || target.isEmpty()) {
+      return;
+    }
+    if (channel != null) {
+      return; // Already configured; flags are not allowed to change mid-command.
+    }
+    RemoteAnalysisCachingServicesOptions servicesOptions =
+        optionsProvider.getOptions(RemoteAnalysisCachingServicesOptions.class);
+    if (authAndTlsOptions == null || servicesOptions == null) {
+      throw abruptExit(
+          "the analysis cache was configured before its options and credentials were resolved",
+          RemoteAnalysisCaching.Code.REMOTE_ANALYSIS_CACHING_UNKNOWN);
+    }
+
+    try {
+      // Bazel's own channel builder rather than a hand-rolled one: it decides TLS from the target's
+      // scheme the way --remote_cache does, applies --tls_certificate and the grpc keepalive
+      // options, honours a proxy, and lifts the inbound message limit.
+      channel =
+          GoogleAuthUtils.newChannel(
+              /* executor= */ null,
+              target,
+              /* proxy= */ null,
+              authAndTlsOptions,
+              /* interceptors= */ null,
+              /* serviceConfig= */ null);
+    } catch (IOException e) {
+      throw abruptExit(
+          "connecting to the remote analysis cache at " + target + ": " + e.getMessage(),
+          RemoteAnalysisCaching.Code.INVALID_SERVER_ADDRESS);
+    }
+
+    scheduler = Executors.newSingleThreadScheduledExecutor();
+    // The deadline is applied per call, not here: withDeadlineAfter on a stored stub is absolute
+    // from the moment the stub is made, so a build outliving it would see every later RPC fail.
+    AnalysisCacheFutureStub stub =
+        AnalysisCacheGrpc.newFutureStub(channel)
+            .withMaxOutboundMessageSize(MAX_OUTBOUND_MESSAGE_BYTES);
+    CallCredentials callCredentials =
+        GoogleAuthUtils.newCallCredentialsProvider(credentials).getCallCredentials();
+    if (callCredentials != null) {
+      stub = stub.withCallCredentials(callCredentials);
+    }
+    long deadlineMillis = servicesOptions.getDeadline().toMillis();
+
+    // One read queue for both readers. A response is the stored bytes whoever asked for them — the
+    // cache client strips the invalidation header on its own side — so the two can share batches,
+    // and sharing is what makes those batches full.
+    gets =
+        new BatchingGetQueue(
+            stub,
+            servicesOptions.getReaderMaxBatchSize(),
+            cachingOptions.getReadLinger().toMillis(),
+            servicesOptions.getMaxInFlightReadRequests(),
+            deadlineMillis,
+            scheduler);
+
+    store =
+        new GrpcFingerprintValueStore(
+            gets,
+            new BatchingPutQueue(
+                stub,
+                servicesOptions.getMaxBatchSize(),
+                PUT_LINGER_MILLIS,
+                deadlineMillis,
+                scheduler));
+    client = new GrpcAnalysisCacheClient(gets);
+  }
+
+  private static SerializedAbruptExitException abruptExit(
+      String message, RemoteAnalysisCaching.Code code) {
+    return new SerializedAbruptExitException(
+        FailureDetail.newBuilder()
+            .setMessage(message)
+            .setRemoteAnalysisCaching(RemoteAnalysisCaching.newBuilder().setCode(code))
+            .build()
+            .toByteArray());
+  }
+
+  /**
+   * Reads answered as misses because the in-flight cap was reached, or 0 when inert.
+   *
+   * <p>Survives {@link #resetCommandState}, so the module can report it after the reset that
+   * releases the queue.
+   */
+  long shedReads() {
+    return gets == null ? shedAtReset : gets.shed();
+  }
+
+  @Override
+  @Nullable
+  public ListenableFuture<GrpcFingerprintValueStore> getFingerprintValueStore() {
+    return store == null ? null : immediateFuture(store);
+  }
+
+  @Override
+  @Nullable
+  public ListenableFuture<GrpcAnalysisCacheClient> getAnalysisCacheClient() {
+    return client == null ? null : immediateFuture(client);
+  }
+
+  @Override
+  public SafeExecutor getCommandExecutor() {
+    return COMMAND_EXECUTOR;
+  }
+
+  @Override
+  public void resetCommandState() {
+    // Writes are acknowledged asynchronously, so anything still queued has to leave before the
+    // channel does or the build reports a successful upload it never sent.
+    if (store != null) {
+      store.flush();
+    }
+    shedAtReset = gets == null ? 0 : gets.shed();
+    if (scheduler != null) {
+      scheduler.shutdown();
+      scheduler = null;
+    }
+    if (channel != null) {
+      channel.shutdown();
+      channel = null;
+    }
+    client = null;
+    store = null;
+    gets = null;
+  }
+
+  @Override
+  public void blazeShutdown() {
+    resetCommandState();
+  }
+}
